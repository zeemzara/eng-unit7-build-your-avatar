const gain=n=>{xp+=n;head()};
function burst(n=24){for(let i=0;i<n;i++){const s=document.createElement('span');s.className='cf';s.textContent=pick(['⭐','✨','🎉','💖','🔷','🟡']);s.style.cssText=`left:${Math.random()*100}vw;font-size:${16+Math.random()*18}px;animation-delay:${Math.random()*.4}s`;document.body.appendChild(s);setTimeout(()=>s.remove(),2400)}}
function showPop(h,b,ms=3200){const p=$('#pop');p.innerHTML=`<div><b>${h}</b><br>${b}</div>`;p.classList.add('show');clearTimeout(pt);pt=setTimeout(()=>p.classList.remove('show'),ms)}
function checkMaster(){if(!master&&done().every(Boolean)&&(created||wins)){master=1;xp+=25;head();$('#win').classList.add('show');burst(70)}}
function vBuild(){$('#view').innerHTML=`<div class="build"><div class="card stage"><div class="av" id="av"><div class="avi" id="avi"></div></div><div class="side"><div class="say" id="say"></div><button class="btn go big" data-a="create">✅ CREATE!</button></div><div class="tb"><button class="btn" data-a="g" data-v="he">👦 He</button><button class="btn" data-a="g" data-v="she">👧 She</button><button class="btn" data-a="listen" aria-label="Listen">🔊</button><button class="btn" data-a="rand">🎲 Random</button><button class="btn" data-a="reset">↺ Reset</button></div></div><div class="card"><div class="cats" id="cats"></div><div id="opts"></div></div></div>`;opts();upd()}
let ft;function flash(h){const e=$('#say');e.classList.add('fl2');e.innerHTML=h;clearTimeout(ft);ft=setTimeout(()=>{e.classList.remove('fl2');e.innerHTML=lines(A).join('<br>')},2600)}
function upd(){$('#say').classList.remove('fl2');$('#avi').innerHTML=svg(A);const e=$('#av');e.classList.remove('pop');void e.offsetWidth;e.classList.add('pop');$('#say').innerHTML=lines(A).join('<br>');$$('[data-a=g]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.v===A.g))}
function opts(){$('#cats').innerHTML=CATS.map(c=>`<button class="btn cat" data-a="cat" data-c="${c[0]}" aria-label="${c[2]}" aria-pressed="${c[0]===cat}"><span>${c[1]}</span>${SHORT[c[0]]}</button>`).join('');
 const C=CATS.find(c=>c[0]===cat);$('#opts').innerHTML=C.slice(3).map(([k,l])=>`<div class="gl">${l||C[2]}</div><div class="opts">${ALL[k].map(v=>{const on=k==='ex'?A.ex.includes(v):A[k]===v,sw=k==='hcol'?HC[v]:k==='eyes'?EC[v]:'';return`<button class="btn opt" data-a="sel" data-k="${k}" data-v="${v}" aria-pressed="${on}">${sw?`<i class="sw" style="background:${sw}"></i>`:''}${v}</button>`}).join('')}</div>`).join('')}
function sel(k,v){const c=CATS.find(c=>c.slice(3).some(g=>g[0]===k))[0],key=k+':'+v,b4=done().filter(Boolean).length;let on=1;
 if(k==='ex'){const i=A.ex.indexOf(v);if(i>=0){A.ex.splice(i,1);on=0}else{if(v==='glasses')A.ex=A.ex.filter(x=>x!=='sunglasses');if(v==='sunglasses')A.ex=A.ex.filter(x=>x!=='glasses');A.ex.push(v)}}
 else{A[k]=v;if((k==='htex'||k==='hcol')&&A.hlen==='bald')A.hlen='short'}
 touched[c]=1;upd();opts();say(v);const lu=done().filter(Boolean).length>b4,nw=on&&!found[key];
 if(nw){found[key]=1;gain(5);burst(16)}else head();
 if(nw||lu)flash(`<b>${nw?'✨ NEW WORD!':'⭐ LEVEL UP!'}</b><br>`+(nw?`<span class="big2">${v}</span><br>${DEF[key]}`:'')+(nw&&lu?'<br>⭐ LEVEL UP!':''))}
function create(){created=1;say(lines(A).join(' '));burst(40);gain(10);flash(`<b>🎉 AVATAR UNLOCKED!</b><br>${done().every(Boolean)?'Great describing!':'Try more buttons to level up!'}`);checkMaster()}
const clues=t=>{const p=parts(t);return[`${p.P} is ${p.hb}.`,p.hair,p.eyes,p.ex||p.face]};
function newMys(){const t=rnd({nobald:1}),ks=['height','build','hlen','htex','hcol','eyes'].concat(t.ex.length?[]:['face']),o=[t],s=new Set([JSON.stringify(t)]);
 while(o.length<4){const d={...t,ex:[...t.ex]};[...ks].sort(()=>Math.random()-.5).slice(0,2+(Math.random()<.4)).forEach(k=>d[k]=pick(ALL[k].filter(x=>x!==t[k]&&x!=='bald')));const j=JSON.stringify(d);if(!s.has(j)){s.add(j);o.push(d)}}
 M={t,o:o.sort(()=>Math.random()-.5),c:1,bad:[],ok:0,msg:'Who is it? Tap the avatar!'}}
function vMys(){const cl=clues(M.t);$('#view').innerHTML=`<div class="card stick"><h2>🕵️ MYSTERY AVATAR</h2>${cl.slice(0,M.c).map((c,i)=>`<p class="clue"><b>CLUE ${i+1}</b> ${c}</p>`).join('')}<div class="row">${M.c<4&&!M.ok?'<button class="btn pri" data-a="nc">👀 Show next clue</button>':''}<button class="btn" data-a="sp">🔊 Listen</button>${M.ok?'<button class="btn go" data-a="nm">Next mystery ▶</button>':''}</div><div class="fb">${M.msg}</div></div><div class="grid4">${M.o.map((o,i)=>`<button class="btn pick ${M.ok&&o===M.t?'okc':''} ${M.sh===i?'shake':''}" data-a="mp" data-i="${i}" ${M.bad.includes(i)||M.ok?'disabled':''}>${svg(o)}<b>${'ABCD'[i]}</b></button>`).join('')}</div>`;M.sh=-1}
function newG(){const a=rnd({nobald:1,ex:1});G={a,v:Array(8).fill(null),r:Array(8).fill(null),e:[a.height,a.build,a.hlen,a.htex,a.hcol,a.eyes,a.face,a.ex[0]],m:'Tap words to fill the gaps. Look at the picture!',cat:'hb'}}
const ph=w=>/^average/.test(w)?'of '+w:/^(beard|moustache)$/.test(w)?'a '+w:w;
function vGuess(){const P=G.a.g==='he'?'He':'She';let i=0;const S=()=>{const k=i++,v=G.v[k];return`<span class="slot ${G.r[k]===1?'ok':G.r[k]===0?'no':''}" data-a="clr" data-i="${k}">${v?ph(v):'&nbsp;&nbsp;&nbsp;'}</span>`};
 const f=[`${P} is ${S()} and ${S()}.`,`${P} has ${S()} ${S()} ${S()} hair.`,`${P} has ${S()} eyes.`,`${P} has a ${S()} face.`,`${P} has ${S()}.`],C=CATS.find(c=>c[0]===G.cat);
 $('#view').innerHTML=`<div class="gwrap"><div class="card gcard"><div class="gl2"><div class="av"><div class="avi">${svg(G.a)}</div></div><button class="btn go" data-a="chk">Check ✅</button><button class="btn" data-a="ng">New avatar</button></div><div><div class="fr">${f.map(x=>`<p>${x}</p>`).join('')}</div><div class="fb">${G.m}</div></div></div><div class="card chipbar"><div class="cats">${CATS.map(c=>`<button class="btn cat" data-a="gcat" data-c="${c[0]}" aria-label="${c[2]}" aria-pressed="${c[0]===G.cat}"><span>${c[1]}</span>${SHORT[c[0]]}</button>`).join('')}</div><div class="chips">${C.slice(3).flatMap(([k])=>ALL[k]).map(w=>`<button class="btn chip" data-a="chip" data-w="${w}" style="background:${CC[G.cat]}">${w}</button>`).join('')}</div></div></div>`}
function vRand(){$('#view').innerHTML=`<div class="card ctr"><h2>🎲 RANDOM AVATAR</h2>${R.a?`<div class="av"><div class="avi">${svg(R.a)}</div></div><div id="tw" ${R.rv?'hidden':''}><p>🤔 Can you describe this person?</p><div class="timer" id="tm">${R.t}</div><button class="btn" data-a="rv">Show answer now</button></div><div class="say" id="rv" ${R.rv?'':'hidden'} style="text-align:left">${lines(R.a).join('<br>')}</div><div class="row"><button class="btn" data-a="sp2">🔊 Listen</button><button class="btn" data-a="edit">✏️ Edit in Build</button></div>`:'<p>Look at a surprise avatar for 10 seconds, then describe it!</p>'}<button class="btn pri big" data-a="rand">🎲 RANDOM AVATAR</button></div>`}
function rollR(){clearInterval(timer);R={a:rnd(),t:10,rv:0};vRand();timer=setInterval(()=>{R.t--;if($('#tm'))$('#tm').textContent=R.t;if(R.t<=0)reveal()},1000)}
function reveal(){clearInterval(timer);R.rv=1;if($('#tw')){$('#tw').hidden=true;$('#rv').hidden=false}say(lines(R.a).join(' '));gain(5)}
function setMode(m){clearInterval(timer);$$('.tab').forEach(b=>b.setAttribute('aria-pressed',b.dataset.m===m));({build:vBuild,mys:()=>{newMys();vMys()},gue:()=>{newG();vGuess()},rand:()=>{R={};vRand()}})[m]()}
const act={
tab:d=>setMode(d.m),cat:d=>{cat=d.c;opts()},sel:d=>sel(d.k,d.v),g:d=>{A.g=d.v;upd()},create,rand:()=>{setMode('rand');rollR()},reset:()=>{A=D0();upd();opts()},listen:()=>say(lines(A).join(' ')),
nc:()=>{M.c++;vMys()},sp:()=>say(clues(M.t)[M.c-1]),nm:()=>{newMys();vMys()},
mp:d=>{const i=+d.i;if(M.ok)return;if(M.o[i]===M.t){M.ok=1;const p=Math.max(10,30-5*(M.c-1));M.msg=`✅ CORRECT! +${p} XP`;showPop('✅ CORRECT!',`+${p} XP`,2200);gain(p);wins++;burst(50);checkMaster()}else{M.bad.push(i);M.sh=i;M.msg='❌ TRY AGAIN!';showPop('❌ TRY AGAIN!','Read the clues again.',1600)}vMys()},
chip:d=>{const i=G.v.indexOf(null);say(d.w);if(i<0)return;G.v[i]=d.w;G.r[i]=null;const n=G.v.indexOf(null);if(n>=0)G.cat=GC[n];vGuess()},gcat:d=>{G.cat=d.c;vGuess()},clr:d=>{G.v[+d.i]=null;G.r[+d.i]=null;vGuess()},ng:()=>{newG();vGuess()},
chk:()=>{if(G.v.includes(null))G.m='Fill every gap first!';else{G.r=G.v.map((x,i)=>x===G.e[i]?1:0);const n=G.r.reduce((a,b)=>a+b,0);if(n===8){G.m='✅ CORRECT! You described the avatar! +20 XP';gain(20);wins++;burst(50);checkMaster()}else G.m=`❌ ${n} / 8 correct. Look at the picture again!`}vGuess()},
rv:reveal,sp2:()=>say(lines(R.a).join(' ')),edit:()=>{A=JSON.parse(JSON.stringify(R.a));setMode('build')},cw:()=>$('#win').classList.remove('show')};
document.addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(b&&act[b.dataset.a])act[b.dataset.a](b.dataset)});
$('#tabs').innerHTML=[['build','🛠️','Build'],['mys','🕵️','Mystery'],['gue','🎮','Guess'],['rand','🎲','Random']].map(t=>`<button class="btn tab" data-a="tab" data-m="${t[0]}"><span>${t[1]}</span>${t[2]}</button>`).join('');
head();setMode('build');
</script>
</body>
</html>
